<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" default-locale="en-GB">
  <info>
    <title>Submitted manuscript numeric style</title>
    <id>https://github.com/HOPE-UIB-BIO/PastHumanImpact/submitted-numeric</id>
    <link href="https://github.com/HOPE-UIB-BIO/PastHumanImpact" rel="self"/>
    <updated>2026-09-01T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/publicdomain/zero/1.0/">Public domain</rights>
  </info>
  <citation collapse="citation-number">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout vertical-align="sup" delimiter=",">
      <text variable="citation-number"/>
    </layout>
  </citation>
  <bibliography second-field-align="flush" entry-spacing="0" line-spacing="1">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout>
      <text variable="citation-number" suffix=". "/>
      <text variable="note"/>
    </layout>
  </bibliography>
</style>

